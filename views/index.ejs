<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Profil szerkesztés
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Profil szerkesztés</h1>
    <form method="post">
        <label>Felhasználónév: <br>
            <input type="text" name="username">
        </label>
        <% if (locals.error) { %>
            <p><%= locals.error %></p>
        <% } %>
        <button type="submit">Módosítás</button>
    </form>
    <p><%= locals.username %></p>
</body>
</html>